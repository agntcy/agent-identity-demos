# Cross-domain agent remediation stack — environment template
# Copy to .env and fill in the change-me-* values.
#   cp .env.example .env

# ── Keycloak A (Org A) ─────────────────────────────────────────────────────
KC_A_ADMIN=admin
KC_A_ADMIN_PASSWORD=change-me-kc-a-admin
KC_A_HTTP_PORT=8082
# Only needed when reverse-proxying Keycloak A's UI under a subpath (e.g.
# /keycloak-a) behind your own TLS/auth gate. Both must be set together:
# KC_A_RELATIVE_PATH becomes Keycloak's own --http-relative-path, and
# KC_A_INTERNAL_URL is what every other service uses to reach it (so the
# resulting token issuer/audience stay consistent everywhere). Leave both
# blank for local use, where Keycloak A is reached directly at "/".
KC_A_RELATIVE_PATH=
KC_A_INTERNAL_URL=

# ── Keycloak B (Org B) ─────────────────────────────────────────────────────
KC_B_ADMIN=admin
KC_B_ADMIN_PASSWORD=change-me-kc-b-admin
KC_B_HTTP_PORT=8083
# Same idea as KC_A_RELATIVE_PATH/KC_A_INTERNAL_URL above, for Keycloak B.
# Envoy's egress/ingress jwt_authn config (envoy-org-a, envoy) has this
# path baked in at build time — if you change it, rebuild both.
KC_B_RELATIVE_PATH=
KC_B_INTERNAL_URL=

# ── Agent credentials (must match realm JSON secrets) ──────────────────────
OPENCODE_CLIENT_SECRET=demo-opencode-secret-change-me
TRIAGE_CLIENT_SECRET=demo-triage-secret-change-me
SUB_AGENT_CLIENT_SECRET=demo-subagent-secret-change-me

# ── Sarah's Keycloak A credentials ─────────────────────────────────────────
# NOTE: SARAH_PASSWORD, OPENCODE_CLIENT_SECRET, TRIAGE_CLIENT_SECRET, and
# SUB_AGENT_CLIENT_SECRET are baked into the realm-import JSON files under
# keycloak-a/ and keycloak-b/ — they must match those files exactly, not be
# freely changed like the other change-me-* values below.
SARAH_USER=sarah
SARAH_PASSWORD=demo-sarah-password-change-me
SARAH_EMAIL=sarah@org-a.example

# ── VC badge issuer ────────────────────────────────────────────────────────
VC_ISSUER_PORT=9003
BADGE_TTL=3600

# ── ID-JAG issuer ──────────────────────────────────────────────────────────
IDJAG_PORT=9002
ASSERTION_TTL=300

# ── AGNTCY Identity Node ───────────────────────────────────────────────────
DB_USERNAME=postgres
DB_PASSWORD=change-me-postgres
DB_NAME=identity
VAULT_DEV_ROOT_TOKEN=change-me-devroot
IDENTITY_NODE_REST_PORT=4005
IDENTITY_NODE_GRPC_PORT=4006
IAM_ORGANIZATION=cross-domain-demo
SECRETS_CRYPTO_KEY=change-me-crypto-key-min-16-chars

# ── Gitea ───────────────────────────────────────────────────────────────────
GITEA_HTTP_PORT=3002
GITEA_SSH_PORT=2223
# GITEA_ROOT_URL is how Gitea generates its own links — set it to the public
# URL (e.g. https://your-domain/gitea/) when reverse-proxying under a
# subpath behind your own TLS/auth gate. Leave as-is for local use.
GITEA_ROOT_URL=http://localhost:3002/
GITEA_ADMIN_USER=demo-admin
GITEA_ADMIN_PASSWORD=change-me-gitea-admin
GITEA_ADMIN_EMAIL=admin@example.com

# ── Agent ports ─────────────────────────────────────────────────────────────
OPENCODE_PORT=8100
SUB_AGENT_PORT=8300

# ── Built On Envoy gateway ──────────────────────────────────────────────────
# Pin these inputs; `docker compose build --pull envoy-org-a envoy-org-b` refreshes them.
BOE_COMPOSER_IMAGE=ghcr.io/tetratelabs/built-on-envoy/composer:0.11.0-dev@sha256:842fca7db63af7385478380bf097c6e85eb16db7158a88778d6f2018b265d84f
ENVOY_BASE_IMAGE=envoyproxy/envoy:v1.38.3@sha256:5f7c43e1147412fdb3af578c651c67478a3df818eae89d2261e707e06c209cdb
ENVOY_IMAGE_TAG=milestone3
ENVOY_TICKET_PORT=10000
ENVOY_RESOURCE_PORT=10001
ENVOY_ADMIN_PORT=9901
ENVOY_A_IMAGE_TAG=milestone4
ENVOY_A_EGRESS_PORT=12000
ENVOY_A_ADMIN_PORT=9902

# ── Demo defaults ───────────────────────────────────────────────────────────
SCAN_REPO=demo-admin/payments-service

# ── AGNTCY Directory Node ──────────────────────────────────────────────────
DIR_POSTGRES_PASSWORD=postgres
DIR_APISERVER_PORT=8888
DIR_ZOT_PORT=5556

# ── OpenTelemetry / Jaeger ──────────────────────────────────────────────────
JAEGER_UI_PORT=16686
# Browser-facing Jaeger UI base URL; set this to show a "View trace" link in
# the webapp once a run finishes (e.g. http://localhost:16686). Leave blank
# to hide the link — useful when Jaeger's UI port isn't publicly reachable.
JAEGER_UI_URL=http://localhost:16686
# Only needed when reverse-proxying the Jaeger UI under a subpath (e.g.
# /jaeger) behind your own TLS/auth gate — set both this and JAEGER_UI_URL
# to match (JAEGER_UI_URL=https://your-domain/jaeger). Leave blank for local
# use, where Jaeger is reached directly at "/".
JAEGER_QUERY_BASE_PATH=
# Public reference links shown in the webapp's "Access these services"
# legend (Gitea, Keycloak A/B admin consoles) — blank hides each entry.
# Set these to match wherever GITEA_ROOT_URL / KC_A_RELATIVE_PATH /
# KC_B_RELATIVE_PATH above actually publish them.
GITEA_UI_URL=
KC_A_UI_URL=
KC_B_UI_URL=

# ── Demo webapp ─────────────────────────────────────────────────────────────
WEBAPP_PORT=8090
