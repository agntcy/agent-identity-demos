{
  "realm": "org-b",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "sslRequired": "external",
  "identityProviders": [
    {
      "alias": "id-jag-keycloak-a",
      "displayName": "ID-JAG Issuer (Keycloak A, native — keycloak-idjag-spi)",
      "providerId": "keycloak-oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "issuer": "http://keycloak-a:8080/realms/org-a",
        "authorizationUrl": "http://keycloak-a:8080/realms/org-a/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak-a:8080/realms/org-a/protocol/openid-connect/token",
        "jwksUrl": "http://keycloak-a:8080/realms/org-a/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "clientId": "idjag-receiver",
        "clientSecret": "demo-idjag-secret-change-me",
        "jwtAuthorizationGrantEnabled": "true",
        "jwtAuthorizationGrantAssertionReuseAllowed": "false",
        "jwtAuthorizationGrantMaxAllowedAssertionExpiration": "300"
      }
    },
    {
      "alias": "id-jag-keycloak-b",
      "displayName": "ID-JAG Issuer (Keycloak B self, native — narrowed sub-badges)",
      "providerId": "keycloak-oidc",
      "enabled": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "config": {
        "issuer": "http://keycloak-b:8080/keycloak-b/realms/org-b",
        "authorizationUrl": "http://keycloak-b:8080/keycloak-b/realms/org-b/protocol/openid-connect/auth",
        "tokenUrl": "http://keycloak-b:8080/keycloak-b/realms/org-b/protocol/openid-connect/token",
        "jwksUrl": "http://keycloak-b:8080/keycloak-b/realms/org-b/protocol/openid-connect/certs",
        "useJwksUrl": "true",
        "clientId": "idjag-receiver",
        "clientSecret": "demo-idjag-secret-change-me",
        "jwtAuthorizationGrantEnabled": "true",
        "jwtAuthorizationGrantAssertionReuseAllowed": "false",
        "jwtAuthorizationGrantMaxAllowedAssertionExpiration": "300"
      }
    }
  ],
  "clients": [
    {
      "clientId": "triage-agent",
      "name": "Triage Agent (Org B receiver)",
      "description": "Org B remediation agent. Receives cross-domain ID-JAG assertions from OpenCode (Org A) and issues downscoped access tokens.",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-triage-secret-change-me",
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "id-jag-keycloak-a",
        "standard.token.exchange.enabled": "true",
        "idjag.allowed.scopes": "openid gitea:write gitea:pr",
        "idjag.allowed.audiences": "http://keycloak-b:8080/keycloak-b/realms/org-b"
      }
    },
    {
      "clientId": "sub-agent",
      "name": "Sub-Agent (Org B, bounded privilege)",
      "description": "Sub-agent spawned by Triage with narrowed badge (caps ⊆ parent, nested act-chain). Redeems sub-badge for a token scoped only to Gitea.",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-subagent-secret-change-me",
      "serviceAccountsEnabled": true,
      "consentRequired": false,
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "id-jag-keycloak-b"
      }
    },
    {
      "clientId": "opencode-agent",
      "name": "OpenCode Agent (Org A) — source read only",
      "description": "Org A's agent as a known party in Org B. Redeems a read-scoped ID-JAG from Keycloak A to read repository source for scanning. Granted gitea:read and nothing else: it cannot write, open PRs, create tickets, or mint further assertions.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "secret": "demo-opencode-secret-change-me",
      "attributes": {
        "oauth2.jwt.authorization.grant.enabled": "true",
        "oauth2.jwt.authorization.grant.idp": "id-jag-keycloak-a"
      }
    }
  ],
  "users": [
    {
      "username": "sarah",
      "email": "sarah@org-a.example",
      "firstName": "Sarah",
      "lastName": "Org-A (federated)",
      "enabled": true,
      "emailVerified": true,
      "credentials": [],
      "federatedIdentities": [
        {
          "identityProvider": "id-jag",
          "userId": "sarah@org-a.example",
          "userName": "sarah"
        },
        {
          "identityProvider": "id-jag-keycloak-a",
          "userId": "sarah@org-a.example",
          "userName": "sarah"
        },
        {
          "identityProvider": "id-jag-keycloak-b",
          "userId": "sarah@org-a.example",
          "userName": "sarah"
        }
      ]
    }
  ]
}
