+++ b/server/identity/agntcy/resolver_test.go
@@ -0,0 +1,172 @@
+// Copyright AGNTCY Contributors (https://github.com/agntcy)
+// SPDX-License-Identifier: Apache-2.0
+
+package agntcy_test
+
+import (
+	"crypto/rand"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	corev1 "github.com/agntcy/dir/api/core/v1"
+	identityv1 "github.com/agntcy/dir/api/identity/v1"
+	identityagntcy "github.com/agntcy/dir/server/identity/agntcy"
+	"github.com/lestrrat-go/jwx/v2/jwk"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"google.golang.org/protobuf/types/known/structpb"
+)
+
+func TestResolver_VerifiesControlAndMatchingAgentBadge(t *testing.T) {
+	fixture := newFixture(t)
+
+	ok, err := fixture.resolver.Verify(t.Context(), fixture.subject, []byte(fixture.claim.GetSignature()), identityv1.CanonicalBytes(fixture.recordCID, fixture.subject, fixture.claim.GetSignedAt()))
+	require.NoError(t, err)
+	assert.True(t, ok)
+}
+
+func TestResolver_RejectsBadgeForDifferentRecord(t *testing.T) {
+	fixture := newFixture(t)
+	fixture.server.Config.Handler = fixture.handler(t, map[string]any{
+		"name":           "different-agent-definition",
+		"schema_version": "1.1.0",
+		"version":        "1.0.0",
+	}, fixture.agentID, true)
+
+	ok, err := fixture.resolver.Verify(t.Context(), fixture.subject, []byte(fixture.claim.GetSignature()), identityv1.CanonicalBytes(fixture.recordCID, fixture.subject, fixture.claim.GetSignedAt()))
+	require.Error(t, err)
+	assert.False(t, ok)
+	assert.Contains(t, err.Error(), "no valid Agent Badge binds")
+}
+
+func TestResolver_RejectsBadgeForDifferentAgent(t *testing.T) {
+	fixture := newFixture(t)
+	fixture.server.Config.Handler = fixture.handler(t, fixture.record, "AGNTCY-other-agent", true)
+
+	ok, err := fixture.resolver.Verify(t.Context(), fixture.subject, []byte(fixture.claim.GetSignature()), identityv1.CanonicalBytes(fixture.recordCID, fixture.subject, fixture.claim.GetSignedAt()))
+	require.Error(t, err)
+	assert.False(t, ok)
+}
+
+func TestResolver_RejectsBadgeThatIdentityNodeDoesNotVerify(t *testing.T) {
+	fixture := newFixture(t)
+	fixture.server.Config.Handler = fixture.handler(t, fixture.record, fixture.agentID, false)
+
+	ok, err := fixture.resolver.Verify(t.Context(), fixture.subject, []byte(fixture.claim.GetSignature()), identityv1.CanonicalBytes(fixture.recordCID, fixture.subject, fixture.claim.GetSignedAt()))
+	require.Error(t, err)
+	assert.False(t, ok)
+}
+
+func TestResolver_RejectsClaimSignedByDifferentKey(t *testing.T) {
+	fixture := newFixture(t)
+	otherKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	otherSigner, err := identityv1.NewKeySigner(pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(otherKey)}))
+	require.NoError(t, err)
+	otherClaim := identityv1.NewIdentityClaim(fixture.subject)
+	require.NoError(t, identityv1.SignIdentityClaim(otherClaim, fixture.recordCID, otherSigner))
+
+	ok, err := fixture.resolver.Verify(t.Context(), fixture.subject, []byte(otherClaim.GetSignature()), identityv1.CanonicalBytes(fixture.recordCID, fixture.subject, otherClaim.GetSignedAt()))
+	require.NoError(t, err)
+	assert.False(t, ok)
+}
+
+type fixture struct {
+	agentID   string
+	subject   string
+	record    map[string]any
+	recordCID string
+	claim     *identityv1.IdentityClaim
+	publicJWK json.RawMessage
+	server    *httptest.Server
+	resolver  *identityagntcy.Resolver
+}
+
+func newFixture(t *testing.T) *fixture {
+	t.Helper()
+
+	privateKey, err := rsa.GenerateKey(rand.Reader, 2048)
+	require.NoError(t, err)
+	key, err := jwk.FromRaw(&privateKey.PublicKey)
+	require.NoError(t, err)
+	publicJWK, err := json.Marshal(key)
+	require.NoError(t, err)
+	var identityNodeJWK map[string]any
+	require.NoError(t, json.Unmarshal(publicJWK, &identityNodeJWK))
+	for _, field := range []string{"d", "p", "q", "dp", "dq", "qi", "priv", "seed"} {
+		identityNodeJWK[field] = ""
+	}
+	publicJWK, err = json.Marshal(identityNodeJWK)
+	require.NoError(t, err)
+
+	agentID := "AGNTCY-security-autonomous-agent"
+	subject := "agntcy:" + agentID
+	record := map[string]any{
+		"name":           "security_autonomous_agent",
+		"schema_version": "1.1.0",
+		"version":        "1.0.0",
+		"annotations": map[string]any{
+			corev1.AnnotationKeyIdentity: subject,
+		},
+	}
+	recordStruct, err := structpb.NewStruct(record)
+	require.NoError(t, err)
+	recordCID := (&corev1.Record{Data: recordStruct}).GetCid()
+	require.NotEmpty(t, recordCID)
+
+	signer, err := identityv1.NewKeySigner(pem.EncodeToMemory(&pem.Block{Type: "RSA PRIVATE KEY", Bytes: x509.MarshalPKCS1PrivateKey(privateKey)}))
+	require.NoError(t, err)
+	claim := identityv1.NewIdentityClaim(subject)
+	require.NoError(t, identityv1.SignIdentityClaim(claim, recordCID, signer))
+
+	f := &fixture{
+		agentID:   agentID,
+		subject:   subject,
+		record:    record,
+		recordCID: recordCID,
+		claim:     claim,
+		publicJWK: publicJWK,
+	}
+	f.server = httptest.NewServer(f.handler(t, record, agentID, true))
+	t.Cleanup(f.server.Close)
+	f.resolver = identityagntcy.New(f.server.URL, f.server.Client())
+
+	return f
+}
+
+func (f *fixture) handler(t *testing.T, record map[string]any, badgeSubject string, badgeValid bool) http.Handler {
+	t.Helper()
+
+	badgePayload, err := json.Marshal(map[string]any{
+		"type": []string{"VerifiableCredential", "AgentBadge"},
+		"credentialSubject": map[string]any{
+			"id":    badgeSubject,
+			"badge": record,
+		},
+	})
+	require.NoError(t, err)
+	compactBadge := base64.RawURLEncoding.EncodeToString([]byte(`{"alg":"RS256"}`)) + "." + base64.RawURLEncoding.EncodeToString(badgePayload) + ".test-signature"
+
+	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		switch r.URL.Path {
+		case "/v1alpha1/id/resolve":
+			_, _ = w.Write([]byte(`{"resolverMetadata":{"id":"` + f.agentID + `","verificationMethod":[{"publicKeyJwk":` + string(f.publicJWK) + `}]}}`))
+		case "/v1alpha1/vc/" + f.agentID + "/.well-known/vcs.json":
+			_ = json.NewEncoder(w).Encode(map[string]any{"vcs": []any{map[string]any{
+				"envelopeType": "CREDENTIAL_ENVELOPE_TYPE_JOSE",
+				"value":        compactBadge,
+			}}})
+		case "/v1alpha1/vc/verify":
+			_ = json.NewEncoder(w).Encode(map[string]bool{"status": badgeValid})
+		default:
+			http.NotFound(w, r)
+		}
+	})
+}
