diff --git a/server/identity/agntcy/resolver.go b/server/identity/agntcy/resolver.go
new file mode 100644
index 0000000..58f0757
--- /dev/null
+++ b/server/identity/agntcy/resolver.go
@@ -0,0 +1,308 @@
+// Copyright AGNTCY Contributors (https://github.com/agntcy)
+// SPDX-License-Identifier: Apache-2.0
+
+// Package agntcy verifies an agntcy: identity claim by resolving the agent's
+// public key and Agent Badge from a configured AGNTCY Identity Node.
+package agntcy
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	corev1 "github.com/agntcy/dir/api/core/v1"
+	identityv1 "github.com/agntcy/dir/api/identity/v1"
+	"github.com/lestrrat-go/jwx/v2/jwk"
+	"google.golang.org/protobuf/types/known/structpb"
+)
+
+const (
+	defaultTimeout = 10 * time.Second
+	maxBodyBytes   = 4 << 20
+)
+
+// Resolver verifies proof of control and badge-backed identity for agntcy: subjects.
+type Resolver struct {
+	baseURL string
+	client  *http.Client
+}
+
+// New creates an AGNTCY Identity resolver. baseURL is administrator-controlled
+// configuration, not a URL supplied by the record publisher.
+func New(baseURL string, client *http.Client) *Resolver {
+	if client == nil {
+		client = &http.Client{Timeout: defaultTimeout}
+	}
+
+	return &Resolver{baseURL: strings.TrimRight(baseURL, "/"), client: client}
+}
+
+// Scheme implements identity.Resolver.
+func (*Resolver) Scheme() string { return "agntcy" }
+
+// Verify resolves the agent key, verifies the CID-bound IdentityClaim, then
+// requires a valid Agent Badge whose subject is the same Agent ID and whose
+// embedded OASF definition hashes to the claimed Directory CID.
+func (r *Resolver) Verify(ctx context.Context, subject string, signature, payload []byte) (bool, error) {
+	agentID, err := agentIDFromSubject(subject)
+	if err != nil {
+		return false, err
+	}
+
+	if r.baseURL == "" {
+		return false, errors.New("AGNTCY Identity Node URL is not configured")
+	}
+
+	keys, err := r.resolveKeys(ctx, agentID)
+	if err != nil {
+		return false, err
+	}
+
+	controlVerified := false
+	for _, key := range keys {
+		if identityv1.VerifyJWS(string(signature), key, payload) == nil {
+			controlVerified = true
+
+			break
+		}
+	}
+	if !controlVerified {
+		return false, nil
+	}
+
+	recordCID, err := recordCIDFromClaimPayload(payload)
+	if err != nil {
+		return false, err
+	}
+
+	return r.verifyMatchingAgentBadge(ctx, agentID, recordCID)
+}
+
+func agentIDFromSubject(subject string) (string, error) {
+	agentID := strings.TrimPrefix(subject, "agntcy:")
+	if agentID == "" || agentID == subject {
+		return "", fmt.Errorf("invalid AGNTCY subject %q", subject)
+	}
+
+	return agentID, nil
+}
+
+func recordCIDFromClaimPayload(payload []byte) (string, error) {
+	parts := strings.Split(string(payload), "|")
+	if len(parts) != 3 || parts[0] == "" {
+		return "", errors.New("invalid IdentityClaim canonical payload")
+	}
+
+	return parts[0], nil
+}
+
+type resolveResponse struct {
+	ResolverMetadata struct {
+		ID                 string `json:"id"`
+		VerificationMethod []struct {
+			PublicKeyJWK json.RawMessage `json:"publicKeyJwk"`
+		} `json:"verificationMethod"`
+	} `json:"resolverMetadata"`
+}
+
+func (r *Resolver) resolveKeys(ctx context.Context, agentID string) ([]any, error) {
+	var response resolveResponse
+	if err := r.requestJSON(ctx, http.MethodPost, "/v1alpha1/id/resolve", map[string]string{"id": agentID}, &response); err != nil {
+		return nil, fmt.Errorf("resolve AGNTCY Agent ID %q: %w", agentID, err)
+	}
+
+	if response.ResolverMetadata.ID != agentID {
+		return nil, fmt.Errorf("Identity Node returned Agent ID %q for %q", response.ResolverMetadata.ID, agentID)
+	}
+
+	keys := make([]any, 0, len(response.ResolverMetadata.VerificationMethod))
+	for _, method := range response.ResolverMetadata.VerificationMethod {
+		publicJWK, err := sanitizePublicJWK(method.PublicKeyJWK)
+		if err != nil {
+			continue
+		}
+
+		key, err := jwk.ParseKey(publicJWK)
+		if err != nil {
+			continue
+		}
+
+		var raw any
+		if err := key.Raw(&raw); err == nil {
+			keys = append(keys, raw)
+		}
+	}
+	if len(keys) == 0 {
+		return nil, fmt.Errorf("Identity Node returned no usable verification keys for %q", agentID)
+	}
+
+	return keys, nil
+}
+
+// sanitizePublicJWK removes private-key members. Identity Node v0.0.26 emits
+// its publicKeyJwk shape with empty RSA private fields, which some JWK parsers
+// interpret as a malformed private key instead of a public key.
+func sanitizePublicJWK(input json.RawMessage) ([]byte, error) {
+	var fields map[string]any
+	if err := json.Unmarshal(input, &fields); err != nil {
+		return nil, fmt.Errorf("parse public JWK: %w", err)
+	}
+
+	for _, name := range []string{"d", "p", "q", "dp", "dq", "qi", "oth", "priv", "seed"} {
+		delete(fields, name)
+	}
+
+	output, err := json.Marshal(fields)
+	if err != nil {
+		return nil, fmt.Errorf("encode public JWK: %w", err)
+	}
+
+	return output, nil
+}
+
+type credentialEnvelope struct {
+	EnvelopeType string `json:"envelopeType"`
+	Value        string `json:"value"`
+}
+
+type wellKnownResponse struct {
+	VCs []credentialEnvelope `json:"vcs"`
+}
+
+type verifyResponse struct {
+	Status bool `json:"status"`
+}
+
+func (r *Resolver) verifyMatchingAgentBadge(ctx context.Context, agentID, recordCID string) (bool, error) {
+	path := "/v1alpha1/vc/" + url.PathEscape(agentID) + "/.well-known/vcs.json"
+
+	var credentials wellKnownResponse
+	if err := r.requestJSON(ctx, http.MethodGet, path, nil, &credentials); err != nil {
+		return false, fmt.Errorf("fetch Agent Badge for %q: %w", agentID, err)
+	}
+
+	for _, credential := range credentials.VCs {
+		if credential.Value == "" || credential.EnvelopeType != "CREDENTIAL_ENVELOPE_TYPE_JOSE" {
+			continue
+		}
+
+		var verified verifyResponse
+		request := map[string]any{"vc": map[string]string{
+			"envelopeType": credential.EnvelopeType,
+			"value":        credential.Value,
+		}}
+		if err := r.requestJSON(ctx, http.MethodPost, "/v1alpha1/vc/verify", request, &verified); err != nil || !verified.Status {
+			continue
+		}
+
+		matches, err := badgeMatches(credential.Value, agentID, recordCID)
+		if err == nil && matches {
+			return true, nil
+		}
+	}
+
+	return false, fmt.Errorf("no valid Agent Badge binds %q to Directory record %q", agentID, recordCID)
+}
+
+func badgeMatches(compactJOSE, agentID, recordCID string) (bool, error) {
+	parts := strings.Split(compactJOSE, ".")
+	if len(parts) != 3 {
+		return false, errors.New("Agent Badge is not compact JOSE")
+	}
+
+	payload, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return false, fmt.Errorf("decode Agent Badge payload: %w", err)
+	}
+
+	var credential map[string]any
+	if err := json.Unmarshal(payload, &credential); err != nil {
+		return false, fmt.Errorf("parse Agent Badge payload: %w", err)
+	}
+	if !hasCredentialType(credential["type"], "AgentBadge") {
+		return false, nil
+	}
+
+	subject, ok := credential["credentialSubject"].(map[string]any)
+	if !ok || subject["id"] != agentID {
+		return false, nil
+	}
+
+	badge, ok := subject["badge"].(map[string]any)
+	if !ok {
+		return false, nil
+	}
+
+	badgeStruct, err := structpb.NewStruct(badge)
+	if err != nil {
+		return false, fmt.Errorf("convert embedded OASF definition: %w", err)
+	}
+
+	return (&corev1.Record{Data: badgeStruct}).GetCid() == recordCID, nil
+}
+
+func hasCredentialType(value any, expected string) bool {
+	switch types := value.(type) {
+	case string:
+		return types == expected
+	case []any:
+		for _, item := range types {
+			if item == expected {
+				return true
+			}
+		}
+	}
+
+	return false
+}
+
+func (r *Resolver) requestJSON(ctx context.Context, method, path string, input, output any) error {
+	var body io.Reader
+	if input != nil {
+		encoded, err := json.Marshal(input)
+		if err != nil {
+			return fmt.Errorf("encode request: %w", err)
+		}
+		body = bytes.NewReader(encoded)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, method, r.baseURL+path, body)
+	if err != nil {
+		return fmt.Errorf("build request: %w", err)
+	}
+	if input != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+
+	resp, err := r.client.Do(req)
+	if err != nil {
+		return fmt.Errorf("perform request: %w", err)
+	}
+	defer resp.Body.Close() //nolint:errcheck
+
+	if resp.StatusCode != http.StatusOK {
+		return fmt.Errorf("Identity Node returned HTTP %d", resp.StatusCode)
+	}
+
+	limited := io.LimitReader(resp.Body, maxBodyBytes+1)
+	data, err := io.ReadAll(limited)
+	if err != nil {
+		return fmt.Errorf("read response: %w", err)
+	}
+	if len(data) > maxBodyBytes {
+		return fmt.Errorf("Identity Node response exceeds %d bytes", maxBodyBytes)
+	}
+	if err := json.Unmarshal(data, output); err != nil {
+		return fmt.Errorf("decode response: %w", err)
+	}
+
+	return nil
+}
