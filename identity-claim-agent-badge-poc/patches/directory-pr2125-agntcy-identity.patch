new file mode 100644
index 0000000..a43d6ad
--- /dev/null
+++ b/server/identity/agntcy/protocol.go
@@ -0,0 +1,52 @@
+// Copyright AGNTCY Contributors (https://github.com/agntcy)
+// SPDX-License-Identifier: Apache-2.0
+
+package agntcy
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+)
+
+const (
+	ProtocolVersion = "agntcy.identity-verification.v1"
+	Profile         = "agntcy-agent-badge.v1"
+)
+
+// VerificationRequest is the complete input needed to verify a Directory
+// IdentityClaim. Payload is the base64url-encoded canonical claim payload.
+type VerificationRequest struct {
+	Subject   string `json:"subject"`
+	Signature string `json:"signature"`
+	Payload   string `json:"payload"`
+}
+
+// VerificationResponse carries a verifier-signed, embedded-payload JWS.
+type VerificationResponse struct {
+	ResultJWS string `json:"resultJws"`
+}
+
+// VerificationResult is signed by the external verifier and bound to the
+// complete request through RequestDigest.
+type VerificationResult struct {
+	Version       string `json:"version"`
+	Verifier      string `json:"verifier"`
+	Profile       string `json:"profile"`
+	Verified      bool   `json:"verified"`
+	Subject       string `json:"subject"`
+	RecordCID     string `json:"recordCid"`
+	RequestDigest string `json:"requestDigest"`
+	CheckedAt     string `json:"checkedAt"`
+	ExpiresAt     string `json:"expiresAt"`
+	Error         string `json:"error,omitempty"`
+}
+
+// DigestRequest returns a stable digest over every request field. The signed
+// result therefore cannot be replayed for another subject, payload, or JWS.
+func DigestRequest(request VerificationRequest) string {
+	encoded, _ := json.Marshal(request)
+	digest := sha256.Sum256(encoded)
+
+	return "sha256:" + hex.EncodeToString(digest[:])
+}
diff --git a/server/identity/agntcy/resolver.go b/server/identity/agntcy/resolver.go
new file mode 100644
index 0000000..2addc21
--- /dev/null
+++ b/server/identity/agntcy/resolver.go
@@ -0,0 +1,183 @@
+// Copyright AGNTCY Contributors (https://github.com/agntcy)
+// SPDX-License-Identifier: Apache-2.0
+
+// Package agntcy is a thin Directory adapter for a separately operated
+// AGNTCY identity verifier. It contains no AGNTCY resolution or VC logic.
+package agntcy
+
+import (
+	"bytes"
+	"context"
+	"crypto"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strings"
+	"time"
+
+	"github.com/lestrrat-go/jwx/v2/jwa"
+	"github.com/lestrrat-go/jwx/v2/jws"
+)
+
+const (
+	defaultTimeout = 10 * time.Second
+	maxBodyBytes   = 1 << 20
+	maxResultAge   = 5 * time.Minute
+)
+
+// Resolver delegates AGNTCY-specific verification and validates the signed
+// result returned by the configured verifier.
+type Resolver struct {
+	baseURL   string
+	publicKey crypto.PublicKey
+	client    *http.Client
+}
+
+// New constructs a resolver with an administrator-pinned verifier endpoint
+// and result-signing public key.
+func New(baseURL, publicKeyPath string, client *http.Client) (*Resolver, error) {
+	if strings.TrimSpace(baseURL) == "" {
+		return nil, errors.New("AGNTCY verifier URL is not configured")
+	}
+
+	publicKey, err := loadPublicKey(publicKeyPath)
+	if err != nil {
+		return nil, err
+	}
+
+	if client == nil {
+		client = &http.Client{Timeout: defaultTimeout}
+	}
+
+	return &Resolver{
+		baseURL:   strings.TrimRight(baseURL, "/"),
+		publicKey: publicKey,
+		client:    client,
+	}, nil
+}
+
+// Scheme implements identity.Resolver.
+func (*Resolver) Scheme() string { return "agntcy" }
+
+// Verify sends the canonical CID-bound claim to the external verifier, then
+// validates and binds its signed result to this exact request.
+func (r *Resolver) Verify(ctx context.Context, subject string, signature, payload []byte) (bool, error) {
+	request := VerificationRequest{
+		Subject:   subject,
+		Signature: string(signature),
+		Payload:   base64.RawURLEncoding.EncodeToString(payload),
+	}
+	encoded, err := json.Marshal(request)
+	if err != nil {
+		return false, fmt.Errorf("encode AGNTCY verification request: %w", err)
+	}
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, r.baseURL+"/v1/verify", bytes.NewReader(encoded))
+	if err != nil {
+		return false, fmt.Errorf("build AGNTCY verification request: %w", err)
+	}
+	req.Header.Set("Content-Type", "application/json")
+
+	response, err := r.client.Do(req)
+	if err != nil {
+		return false, fmt.Errorf("call external AGNTCY verifier: %w", err)
+	}
+	defer response.Body.Close() //nolint:errcheck
+
+	if response.StatusCode != http.StatusOK {
+		return false, fmt.Errorf("external AGNTCY verifier returned HTTP %d", response.StatusCode)
+	}
+
+	body, err := io.ReadAll(io.LimitReader(response.Body, maxBodyBytes+1))
+	if err != nil {
+		return false, fmt.Errorf("read AGNTCY verifier response: %w", err)
+	}
+	if len(body) > maxBodyBytes {
+		return false, errors.New("AGNTCY verifier response exceeds size limit")
+	}
+
+	var envelope VerificationResponse
+	if err := json.Unmarshal(body, &envelope); err != nil || envelope.ResultJWS == "" {
+		return false, errors.New("external AGNTCY verifier returned an invalid response")
+	}
+
+	verifiedPayload, err := jws.Verify(
+		[]byte(envelope.ResultJWS),
+		jws.WithKey(jwa.RS256, r.publicKey),
+	)
+	if err != nil {
+		return false, fmt.Errorf("verify external AGNTCY verifier result: %w", err)
+	}
+
+	var result VerificationResult
+	if err := json.Unmarshal(verifiedPayload, &result); err != nil {
+		return false, fmt.Errorf("parse external AGNTCY verifier result: %w", err)
+	}
+
+	recordCID, err := recordCIDFromClaimPayload(payload)
+	if err != nil {
+		return false, err
+	}
+	if err := validateResult(result, request, subject, recordCID, time.Now()); err != nil {
+		return false, err
+	}
+
+	return result.Verified, nil
+}
+
+func validateResult(result VerificationResult, request VerificationRequest, subject, recordCID string, now time.Time) error {
+	if result.Version != ProtocolVersion || result.Profile != Profile {
+		return errors.New("external verifier returned an unsupported result version or profile")
+	}
+	if result.Subject != subject || result.RecordCID != recordCID {
+		return errors.New("external verifier result is not bound to the requested subject and record CID")
+	}
+	if result.RequestDigest != DigestRequest(request) {
+		return errors.New("external verifier result is not bound to the complete request")
+	}
+	checkedAt, err := time.Parse(time.RFC3339, result.CheckedAt)
+	if err != nil || checkedAt.After(now.Add(time.Minute)) || now.Sub(checkedAt) > maxResultAge {
+		return errors.New("external verifier result has an invalid or stale checkedAt")
+	}
+	expiresAt, err := time.Parse(time.RFC3339, result.ExpiresAt)
+	if err != nil || !expiresAt.After(now) {
+		return errors.New("external verifier result is expired")
+	}
+
+	return nil
+}
+
+func recordCIDFromClaimPayload(payload []byte) (string, error) {
+	parts := strings.Split(string(payload), "|")
+	if len(parts) != 3 || parts[0] == "" {
+		return "", errors.New("invalid IdentityClaim canonical payload")
+	}
+
+	return parts[0], nil
+}
+
+func loadPublicKey(path string) (crypto.PublicKey, error) {
+	if strings.TrimSpace(path) == "" {
+		return nil, errors.New("AGNTCY verifier public-key path is not configured")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, fmt.Errorf("read AGNTCY verifier public key: %w", err)
+	}
+	block, _ := pem.Decode(data)
+	if block == nil {
+		return nil, errors.New("decode AGNTCY verifier public key PEM")
+	}
+	key, err := x509.ParsePKIXPublicKey(block.Bytes)
+	if err != nil {
+		return nil, fmt.Errorf("parse AGNTCY verifier public key: %w", err)
+	}
+
+	return key, nil
+}
