diff --git a/server/cmd/agntcy-identity-verifier/main.go b/server/cmd/agntcy-identity-verifier/main.go
new file mode 100644
index 0000000..25dac4c
--- /dev/null
+++ b/server/cmd/agntcy-identity-verifier/main.go
@@ -0,0 +1,373 @@
+// Copyright AGNTCY Contributors (https://github.com/agntcy)
+// SPDX-License-Identifier: Apache-2.0
+
+// agntcy-identity-verifier externalizes AGNTCY-specific identity resolution,
+// proof-of-control verification, Agent Badge validation, and CID binding.
+package main
+
+import (
+	"bytes"
+	"context"
+	"crypto/rsa"
+	"crypto/x509"
+	"encoding/base64"
+	"encoding/json"
+	"encoding/pem"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+	"sync/atomic"
+	"time"
+
+	corev1 "github.com/agntcy/dir/api/core/v1"
+	identityv1 "github.com/agntcy/dir/api/identity/v1"
+	"github.com/agntcy/dir/server/identity/agntcy"
+	"github.com/lestrrat-go/jwx/v2/jwa"
+	"github.com/lestrrat-go/jwx/v2/jwk"
+	"github.com/lestrrat-go/jwx/v2/jws"
+	"google.golang.org/protobuf/types/known/structpb"
+)
+
+const (
+	maxBodyBytes = 4 << 20
+	resultTTL    = 4 * time.Minute
+)
+
+type server struct {
+	identityURL string
+	verifierID  string
+	privateKey  *rsa.PrivateKey
+	client      *http.Client
+	requests    atomic.Uint64
+}
+
+type resolveResponse struct {
+	ResolverMetadata struct {
+		ID                 string `json:"id"`
+		VerificationMethod []struct {
+			PublicKeyJWK json.RawMessage `json:"publicKeyJwk"`
+		} `json:"verificationMethod"`
+	} `json:"resolverMetadata"`
+}
+
+type credentialEnvelope struct {
+	EnvelopeType string `json:"envelopeType"`
+	Value        string `json:"value"`
+}
+
+type wellKnownResponse struct {
+	VCs []credentialEnvelope `json:"vcs"`
+}
+
+type verifyResponse struct {
+	Status bool `json:"status"`
+}
+
+func main() {
+	listen := envOr("LISTEN_ADDRESS", ":8080")
+	identityURL := strings.TrimRight(os.Getenv("IDENTITY_NODE_URL"), "/")
+	if identityURL == "" {
+		log.Fatal("IDENTITY_NODE_URL is required")
+	}
+	privateKey, err := loadPrivateKey(os.Getenv("RESULT_SIGNING_KEY_PATH"))
+	if err != nil {
+		log.Fatalf("load result-signing key: %v", err)
+	}
+
+	s := &server{
+		identityURL: identityURL,
+		verifierID:  envOr("VERIFIER_ID", "agntcy-identity-verifier-poc"),
+		privateKey:  privateKey,
+		client:      &http.Client{Timeout: 10 * time.Second},
+	}
+	mux := http.NewServeMux()
+	mux.HandleFunc("GET /healthz", func(w http.ResponseWriter, _ *http.Request) {
+		writeJSON(w, http.StatusOK, map[string]any{"status": "ok"})
+	})
+	mux.HandleFunc("GET /v1/stats", func(w http.ResponseWriter, _ *http.Request) {
+		writeJSON(w, http.StatusOK, map[string]any{"verificationRequests": s.requests.Load()})
+	})
+	mux.HandleFunc("POST /v1/verify", s.verify)
+
+	log.Printf("external AGNTCY identity verifier listening on %s", listen)
+	if err := http.ListenAndServe(listen, mux); err != nil { //nolint:gosec
+		log.Fatal(err)
+	}
+}
+
+func (s *server) verify(w http.ResponseWriter, req *http.Request) {
+	s.requests.Add(1)
+	defer req.Body.Close() //nolint:errcheck
+
+	var input agntcy.VerificationRequest
+	decoder := json.NewDecoder(io.LimitReader(req.Body, maxBodyBytes+1))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&input); err != nil {
+		http.Error(w, "invalid verification request", http.StatusBadRequest)
+		return
+	}
+
+	payload, err := base64.RawURLEncoding.DecodeString(input.Payload)
+	if err != nil {
+		http.Error(w, "invalid canonical payload", http.StatusBadRequest)
+		return
+	}
+	recordCID, payloadSubject, err := parseCanonicalPayload(payload)
+	if err != nil || payloadSubject != input.Subject {
+		http.Error(w, "canonical payload does not match request", http.StatusBadRequest)
+		return
+	}
+
+	checkedAt := time.Now().UTC()
+	result := agntcy.VerificationResult{
+		Version:       agntcy.ProtocolVersion,
+		Verifier:      s.verifierID,
+		Profile:       agntcy.Profile,
+		Subject:       input.Subject,
+		RecordCID:     recordCID,
+		RequestDigest: agntcy.DigestRequest(input),
+		CheckedAt:     checkedAt.Format(time.RFC3339),
+		ExpiresAt:     checkedAt.Add(resultTTL).Format(time.RFC3339),
+	}
+
+	result.Verified, result.Error = s.evaluate(req.Context(), input, payload, recordCID)
+	signed, err := s.signResult(result)
+	if err != nil {
+		http.Error(w, "could not sign verification result", http.StatusInternalServerError)
+		return
+	}
+	writeJSON(w, http.StatusOK, agntcy.VerificationResponse{ResultJWS: signed})
+}
+
+func (s *server) evaluate(ctx context.Context, request agntcy.VerificationRequest, payload []byte, recordCID string) (bool, string) {
+	agentID := strings.TrimPrefix(request.Subject, "agntcy:")
+	if agentID == "" || agentID == request.Subject {
+		return false, "invalid AGNTCY subject"
+	}
+
+	keys, err := s.resolveKeys(ctx, agentID)
+	if err != nil {
+		return false, "identity resolution failed"
+	}
+	controlVerified := false
+	for _, key := range keys {
+		if identityv1.VerifyJWS(request.Signature, key, payload) == nil {
+			controlVerified = true
+			break
+		}
+	}
+	if !controlVerified {
+		return false, "proof of control failed"
+	}
+
+	matched, err := s.verifyMatchingAgentBadge(ctx, agentID, recordCID)
+	if err != nil || !matched {
+		return false, "no valid Agent Badge binds the subject to the Directory record"
+	}
+
+	return true, ""
+}
+
+func (s *server) resolveKeys(ctx context.Context, agentID string) ([]any, error) {
+	var response resolveResponse
+	if err := s.requestJSON(ctx, http.MethodPost, "/v1alpha1/id/resolve", map[string]string{"id": agentID}, &response); err != nil {
+		return nil, err
+	}
+	if response.ResolverMetadata.ID != agentID {
+		return nil, errors.New("resolved identity does not match requested Agent ID")
+	}
+
+	keys := make([]any, 0, len(response.ResolverMetadata.VerificationMethod))
+	for _, method := range response.ResolverMetadata.VerificationMethod {
+		publicJWK, err := sanitizePublicJWK(method.PublicKeyJWK)
+		if err != nil {
+			continue
+		}
+		key, err := jwk.ParseKey(publicJWK)
+		if err != nil {
+			continue
+		}
+		var raw any
+		if err := key.Raw(&raw); err == nil {
+			keys = append(keys, raw)
+		}
+	}
+	if len(keys) == 0 {
+		return nil, errors.New("no usable verification keys")
+	}
+
+	return keys, nil
+}
+
+func (s *server) verifyMatchingAgentBadge(ctx context.Context, agentID, recordCID string) (bool, error) {
+	path := "/v1alpha1/vc/" + url.PathEscape(agentID) + "/.well-known/vcs.json"
+	var credentials wellKnownResponse
+	if err := s.requestJSON(ctx, http.MethodGet, path, nil, &credentials); err != nil {
+		return false, err
+	}
+
+	for _, credential := range credentials.VCs {
+		if credential.Value == "" || credential.EnvelopeType != "CREDENTIAL_ENVELOPE_TYPE_JOSE" {
+			continue
+		}
+		var verified verifyResponse
+		body := map[string]any{"vc": map[string]string{
+			"envelopeType": credential.EnvelopeType,
+			"value":        credential.Value,
+		}}
+		if err := s.requestJSON(ctx, http.MethodPost, "/v1alpha1/vc/verify", body, &verified); err != nil || !verified.Status {
+			continue
+		}
+		matches, err := badgeMatches(credential.Value, agentID, recordCID)
+		if err == nil && matches {
+			return true, nil
+		}
+	}
+
+	return false, nil
+}
+
+func (s *server) requestJSON(ctx context.Context, method, path string, input, output any) error {
+	var body io.Reader
+	if input != nil {
+		encoded, err := json.Marshal(input)
+		if err != nil {
+			return err
+		}
+		body = bytes.NewReader(encoded)
+	}
+	req, err := http.NewRequestWithContext(ctx, method, s.identityURL+path, body)
+	if err != nil {
+		return err
+	}
+	if input != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	response, err := s.client.Do(req)
+	if err != nil {
+		return err
+	}
+	defer response.Body.Close() //nolint:errcheck
+	if response.StatusCode != http.StatusOK {
+		return fmt.Errorf("Identity Node returned HTTP %d", response.StatusCode)
+	}
+	data, err := io.ReadAll(io.LimitReader(response.Body, maxBodyBytes+1))
+	if err != nil || len(data) > maxBodyBytes {
+		return errors.New("invalid Identity Node response")
+	}
+	return json.Unmarshal(data, output)
+}
+
+func (s *server) signResult(result agntcy.VerificationResult) (string, error) {
+	payload, err := json.Marshal(result)
+	if err != nil {
+		return "", err
+	}
+	signed, err := jws.Sign(payload, jws.WithKey(jwa.RS256, s.privateKey))
+	if err != nil {
+		return "", err
+	}
+	return string(signed), nil
+}
+
+func parseCanonicalPayload(payload []byte) (string, string, error) {
+	parts := strings.Split(string(payload), "|")
+	if len(parts) != 3 || parts[0] == "" || parts[1] == "" {
+		return "", "", errors.New("invalid IdentityClaim canonical payload")
+	}
+	return parts[0], parts[1], nil
+}
+
+func badgeMatches(compactJOSE, agentID, recordCID string) (bool, error) {
+	parts := strings.Split(compactJOSE, ".")
+	if len(parts) != 3 {
+		return false, errors.New("Agent Badge is not compact JOSE")
+	}
+	payload, err := base64.RawURLEncoding.DecodeString(parts[1])
+	if err != nil {
+		return false, err
+	}
+	var credential map[string]any
+	if err := json.Unmarshal(payload, &credential); err != nil {
+		return false, err
+	}
+	if !hasCredentialType(credential["type"], "AgentBadge") {
+		return false, nil
+	}
+	subject, ok := credential["credentialSubject"].(map[string]any)
+	if !ok || subject["id"] != agentID {
+		return false, nil
+	}
+	badge, ok := subject["badge"].(map[string]any)
+	if !ok {
+		return false, nil
+	}
+	badgeStruct, err := structpb.NewStruct(badge)
+	if err != nil {
+		return false, err
+	}
+	return (&corev1.Record{Data: badgeStruct}).GetCid() == recordCID, nil
+}
+
+func hasCredentialType(value any, expected string) bool {
+	switch types := value.(type) {
+	case string:
+		return types == expected
+	case []any:
+		for _, item := range types {
+			if item == expected {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func sanitizePublicJWK(input json.RawMessage) ([]byte, error) {
+	var fields map[string]any
+	if err := json.Unmarshal(input, &fields); err != nil {
+		return nil, err
+	}
+	for _, name := range []string{"d", "p", "q", "dp", "dq", "qi", "oth", "priv", "seed"} {
+		delete(fields, name)
+	}
+	return json.Marshal(fields)
+}
+
+func loadPrivateKey(path string) (*rsa.PrivateKey, error) {
+	if path == "" {
+		return nil, errors.New("RESULT_SIGNING_KEY_PATH is required")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	block, _ := pem.Decode(data)
+	if block == nil {
+		return nil, errors.New("invalid private-key PEM")
+	}
+	if key, err := x509.ParsePKCS8PrivateKey(block.Bytes); err == nil {
+		if rsaKey, ok := key.(*rsa.PrivateKey); ok {
+			return rsaKey, nil
+		}
+	}
+	return x509.ParsePKCS1PrivateKey(block.Bytes)
+}
+
+func writeJSON(w http.ResponseWriter, status int, value any) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	_ = json.NewEncoder(w).Encode(value)
+}
+
+func envOr(name, fallback string) string {
+	if value := os.Getenv(name); value != "" {
+		return value
+	}
+	return fallback
+}
