diff --git a/server/store/oci/types_agent_badge_test.go b/server/store/oci/types_agent_badge_test.go
new file mode 100644
index 0000000..550aa3e
--- /dev/null
+++ b/server/store/oci/types_agent_badge_test.go
@@ -0,0 +1,28 @@
+// Copyright AGNTCY Contributors (https://github.com/agntcy)
+// SPDX-License-Identifier: Apache-2.0
+
+package oci
+
+import (
+	"testing"
+
+	corev1 "github.com/agntcy/dir/api/core/v1"
+)
+
+func TestAgentBadgeTypeMapping(t *testing.T) {
+	if got := apiToOCIType(corev1.AgentBadgeReferrerType); got != AgentBadgeArtifactMediaType {
+		t.Fatalf("apiToOCIType() = %q, want %q", got, AgentBadgeArtifactMediaType)
+	}
+	if got := ociToAPIType(AgentBadgeArtifactMediaType); got != corev1.AgentBadgeReferrerType {
+		t.Fatalf("ociToAPIType() = %q, want %q", got, corev1.AgentBadgeReferrerType)
+	}
+}
+
+func TestLegalEntityCredentialTypeMapping(t *testing.T) {
+	if got := apiToOCIType(corev1.LegalEntityCredentialReferrerType); got != LegalEntityCredentialArtifactMediaType {
+		t.Fatalf("apiToOCIType() = %q, want %q", got, LegalEntityCredentialArtifactMediaType)
+	}
+	if got := ociToAPIType(LegalEntityCredentialArtifactMediaType); got != corev1.LegalEntityCredentialReferrerType {
+		t.Fatalf("ociToAPIType() = %q, want %q", got, corev1.LegalEntityCredentialReferrerType)
+	}
+}
